{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NiimBlue",
  "version": "1.0.0",
  "identifier": "app.niimblue.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build-www",
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NiimBlue",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": { "infoPlist": "Info.plist" }
  }
}
